# --- App ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://mjh:mjh@localhost:5432/mjh?schema=public

# --- Auth / JWT ---
# Use a long, random secret in production (openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_DAYS=7

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Redis (optional; sessions/caching) ---
REDIS_URL=redis://localhost:6379

# --- File storage (optional, for production S3 presigned uploads) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=mjh-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
